# Mark the request as "production" based on the host name
SetEnvIf Host "^(localhost|127\.0\.0\.1|.*\.local|.*\.test)(:[0-9]+)?$" IS_DEV

AuthType Basic
AuthName "Restricted Area"
AuthUserFile /var/www/html/mediawiki/.htpasswd

# Allow unrestricted access unless REQUIRE_AUTH is set
<RequireAny>
    Require env IS_DEV
    Require valid-user
</RequireAny>

RewriteEngine On

# Don't rewrite if the requested file/directory actually exists
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Don't rewrite requests already going to index.php
#RewriteRule ^([a-zA-Z0-9]+)/mediawiki/(.*)$ /$1/mediawiki/index.php/$2 [L]
RewriteRule ^(.*)$ /mediawiki/index.php/$2 [L]
